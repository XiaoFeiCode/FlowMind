# ============================================================
# FlowMind Docker 环境变量模板
# 复制此文件为 .docker.env 并填入真实密钥
# .docker.env 已在 .gitignore 中排除，不会被提交到 Git
# ============================================================

# 阿里云百炼 / DashScope API Key（通义千问）
DASHSCOPE_API_KEY=你的百炼平台API_KEY

# Neo4j 图数据库密码
NEO4J_PASSWORD=请设置强密码至少8位

# MySQL Root 密码
MYSQL_PASSWORD=请设置强密码至少8位

# 嵌入模型路径（容器内路径，一般不需要修改）
EMBEDDING_MODEL=/app/models/bge-base-zh-v1.5
